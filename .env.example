# Local frontend: http://localhost:5173; backend: http://127.0.0.1:3000
VITE_API_BASE_URL=/api/v1
# Staging deployment: https://bookmysku-staging-647834327133.asia-south1.run.app/api/v1
API_PROXY_TARGET=http://127.0.0.1:3000

# Public values from the same Supabase project as the backend OIDC_ISSUER.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Stripe publishable key only. Hosted Checkout URLs are returned by the backend.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# URL of the published registration terms, if available.
VITE_REGISTRATION_TERMS_URL=
